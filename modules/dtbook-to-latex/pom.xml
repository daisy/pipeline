<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.daisy.pipeline.modules</groupId>
    <artifactId>modules-parent</artifactId>
    <version>1.15.6-SNAPSHOT</version>
    <relativePath>../parent/</relativePath>
  </parent>

  <artifactId>dtbook-to-latex</artifactId>
  <version>1.0.1-SNAPSHOT</version>
  <packaging>bundle</packaging>

  <name>DAISY Pipeline 2 module :: DTBook to LaTeX</name>

  <developers>
    <developer>
      <id>linus.ericson</id>
      <name>Linus Ericson</name>
      <organization>MTM (Myndigheten för tillgängliga medier)</organization>
      <organizationUrl>http://www.mtm.se/</organizationUrl>
      <roles>
        <role>Developer</role>
      </roles>
    </developer>
    <developer>
      <id>egli</id>
      <name>Christian Egli</name>
      <email>christian.egli@sbs.ch</email>
      <organization>SBS - Schweizerische Bibliothek für Blinde, Seh- und Lesebehinderte</organization>
      <organizationUrl>http://sbs.ch/</organizationUrl>
      <roles>
        <role>Developer</role>
      </roles>
      <timezone>UTC+01:00</timezone>
    </developer>
  </developers>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>xml/dtbook-to-latex.script.xpl</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>xml/dtbook-to-latex.script.xpl</include>
        </includes>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.daisy.pipeline</groupId>
      <artifactId>framework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.daisy.pipeline.modules</groupId>
      <artifactId>file-utils</artifactId>
    </dependency>
  </dependencies>

  <properties>
    <expose-services>
      org.daisy.pipeline.modules.impl.Module_dtbook_to_latex,
      org.daisy.pipeline.script.impl.XProcScript_dtbook_to_latex,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_font_size,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_page_style,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_alignment,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_default_language,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_stock_size,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_line_spacing,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_replace_em_with_quote,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_endnotes,
      org.daisy.pipeline.datatypes.impl.Datatype_px_dtbook_to_latex_script_include_images
    </expose-services>
  </properties>

</project>
